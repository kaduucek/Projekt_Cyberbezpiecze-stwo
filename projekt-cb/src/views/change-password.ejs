<%- include('partials/header') %>
<div class="card narrow">
  <h1>Zmiana hasła</h1>

  <% if (reasonText) { %><p class="alert info"><%= reasonText %></p><% } %>

  <% if (errors.length > 0) { %>
    <div class="alert error">
      <ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>

  <form method="post" action="/change-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="current_password">
      <%= isOtp ? 'Hasło jednorazowe (otrzymane od administratora)' : 'Obecne hasło' %>
    </label>
    <input type="password" id="current_password" name="current_password" required autocomplete="current-password">

    <label for="new_password">Nowe hasło</label>
    <input type="password" id="new_password" name="new_password" required autocomplete="new-password">
    <small class="muted" id="length-info">Długość: 0 znaków</small>

    <label for="new_password_confirm">Powtórz nowe hasło</label>
    <input type="password" id="new_password_confirm" name="new_password_confirm" required autocomplete="new-password">

    <button type="submit" class="btn">Zmień hasło</button>
    <% if (!forced) { %><a href="/" class="btn btn-secondary">Anuluj</a><% } %>
  </form>

  <h3>Wymagania dla hasła</h3>
  <ul class="rules">
    <% rules.forEach((r) => { %><li><%= r %></li><% }) %>
  </ul>
  <p class="muted">Liczy się długość, a nie złożoność – możesz użyć kilku słów ze spacjami,
    np. „mój kot lubi zielone ogórki”.</p>
</div>

<script>
  // Licznik długości nowego hasła
  const input = document.getElementById('new_password');
  const info = document.getElementById('length-info');
  input.addEventListener('input', () => {
    info.textContent = 'Długość: ' + [...input.value].length + ' znaków';
  });
</script>
<%- include('partials/footer') %>